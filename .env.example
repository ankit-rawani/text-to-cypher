# Text2Cypher sample environment.
# Copy to `.env` (git-ignored) and fill in. The CLI/pipeline auto-loads `.env`
# from the repo root; real environment variables always win over this file.
#
#   cp .env.example .env      # then edit, then:  t2c ask "..."

# ============================================================
# LLM — query generation
# ============================================================
# provider: "anthropic" (native Claude Messages API) or "openai" (OpenAI-compatible)
LLM_PROVIDER=anthropic

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# Base URL — the default public API, or any Anthropic-compatible proxy/gateway.
LLM_ENDPOINT=https://api.anthropic.com
# Any Claude model id, e.g.: claude-opus-4-8 | claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
LLM_MODEL=claude-sonnet-5
# Your Anthropic API key (sk-ant-...). Keep this secret; never commit `.env`.
LLM_API_KEY=sk-ant-your-key-here
# Headroom for the JSON answer (+ any model-side thinking tokens).
LLM_MAX_TOKENS=4096
# Current Claude models reject `temperature` (HTTP 400) — leave false for them.
# Set true only for older models that accept sampling params.
LLM_SEND_TEMPERATURE=false

# --- OpenAI-compatible alternative (set LLM_PROVIDER=openai) ---
# LLM_PROVIDER=openai
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...
# LLM_SEND_TEMPERATURE=true

# ============================================================
# ArcadeDB — the graph (READ-ONLY credential required)
# ============================================================
ARCADE_URL=http://localhost:2480
ARCADE_DB=concept_graph
ARCADE_RO_USER=readonly
ARCADE_RO_PASSWORD=change-me

# ============================================================
# Qdrant — node & example vectors
# ============================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================================
# Embeddings — grounding & example retrieval
# ============================================================
# "hashing" = offline/deterministic (no key, good for local testing);
# "openai"  = OpenAI-compatible /embeddings endpoint.
EMBED_PROVIDER=hashing
# EMBED_ENDPOINT=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# EMBED_API_KEY=

# ============================================================
# MongoDB — optional row hydration (off by default)
# ============================================================
# MONGO_URL=
# MONGO_DB=
# MONGO_COLLECTION=
